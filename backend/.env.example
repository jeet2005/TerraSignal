# TerraSignal Backend Configuration
# Copy to .env and fill in your API keys

# Database
POSTGRES_DB=terrasignal
POSTGRES_USER=terrasignal
POSTGRES_PASSWORD=terrasignal
DATABASE_URL=postgresql+asyncpg://terrasignal:terrasignal@localhost:5432/terrasignal

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Keys (get from respective providers)
# Environment & Climate
USGS_API_KEY=
OPENWEATHER_API_KEY=
OPENAQ_API_KEY=
NASA_FIRMS_API_KEY=
NOAA_API_KEY=

# Movement
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_API_KEY=
TRANSITLAND_API_KEY=
TOMTOM_API_KEY=

# Space
N2YO_API_KEY=

# Economics
COINGECKO_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
EXCHANGERATE_API_KEY=
WORLD_BANK_API_KEY=
COMMODITY_API_KEY=

# Humanitarian & Geopolitical
GDELT_API_KEY=
RELIEFWEB_API_KEY=
ACLED_API_KEY=

# Digital World
CLOUDFLARE_RADAR_API_KEY=

# Frontend
MAPBOX_TOKEN=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@terrasignal.io